{
  "name": "precinct-noir-e2e",
  "private": true,
  "description": "Browser tests: a TV and two phones play Shadow Duel against the production image.",
  "scripts": {
    "test": "playwright test",
    "video": "E2E_VIDEO=1 playwright test && node stitch.mjs",
    "stitch": "node stitch.mjs",
    "stack:up": "docker compose -f compose.yaml up -d --build --wait",
    "stack:down": "docker compose -f compose.yaml down -v",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
